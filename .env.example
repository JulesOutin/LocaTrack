# Base de données Neon (chaîne de connexion poolée, avec sslmode=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optionnel : branche Neon séparée pour les tests d'intégration
# (npm run test:integration). Créez-la par branchement depuis votre branche
# principale (`create_branch` via le MCP Neon, ou dans la console Neon) afin
# de ne jamais exécuter les tests contre des données réelles.
TEST_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon Auth (Stack Auth) — voir https://console.neon.tech/ > votre projet > Auth
# ou https://app.stack-auth.com après provisionnement via `provision_neon_auth`.
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# Vercel Blob (upload des photos de matériel)
# Créé automatiquement en liant un Blob store au projet Vercel, ou via `vercel blob store create`.
BLOB_READ_WRITE_TOKEN=""

# URL publique de base de l'application (utilisée pour générer les URL des QR codes)
# En local : http://localhost:3000 — en production : https://votre-domaine.vercel.app
APP_BASE_URL="http://localhost:3000"
